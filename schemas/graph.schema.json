{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/james-agent-context/graph.schema.json",
  "title": "Compact functional graph",
  "type": "object",
  "required": ["$schema", "schema_version", "title", "language", "purpose", "scope", "entities", "relationships", "claims", "unknowns"],
  "properties": {
    "$schema": {"type":"string"},
    "schema_version": {"type":"string"},
    "title": {"type":"string"},
    "language": {"type":"string"},
    "purpose": {"type":"string"},
    "scope": {"$ref":"#/$defs/scope"},
    "entities": {"type":"array", "minItems":12, "maxItems":20, "items":{"$ref":"#/$defs/node"}},
    "relationships": {"type":"array", "items":{"$ref":"#/$defs/relationship"}},
    "claims": {"type":"array", "items":{"$ref":"#/$defs/claim"}},
    "unknowns": {"type":"array", "minItems":1, "items":{"$ref":"#/$defs/unknown"}}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {"type":"string", "enum":["fact", "inference"]},
    "id": {"type":"string", "pattern":"^[a-z][a-z0-9-]*$"},
    "predicate": {"type":"string", "pattern":"^[a-z][a-z0-9_-]*$"},
    "scope": {"type":"object", "required":["included","excluded"], "properties":{"included":{"type":"string"},"excluded":{"type":"string"}}, "additionalProperties":false},
    "node": {"type":"object", "required":["id","label","kind","summary","evidence_type","source_ids"], "properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string"},"kind":{"type":"string"},"summary":{"type":"string"},"evidence_type":{"$ref":"#/$defs/evidence"},"source_ids":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}}}, "additionalProperties":false},
    "relationship": {"type":"object", "required":["id","from","to","predicate","evidence_type","summary","source_ids"], "properties":{"id":{"$ref":"#/$defs/id"},"from":{"$ref":"#/$defs/id"},"to":{"$ref":"#/$defs/id"},"predicate":{"$ref":"#/$defs/predicate"},"evidence_type":{"$ref":"#/$defs/evidence"},"summary":{"type":"string"},"source_ids":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}}}, "additionalProperties":false},
    "claim": {"type":"object", "required":["id","statement","evidence_type","source_ids"], "properties":{"id":{"$ref":"#/$defs/id"},"statement":{"type":"string"},"evidence_type":{"$ref":"#/$defs/evidence"},"source_ids":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}}}, "additionalProperties":false},
    "unknown": {"type":"object", "required":["id","statement"], "properties":{"id":{"$ref":"#/$defs/id"},"statement":{"type":"string"}}, "additionalProperties":false}
  }
}
